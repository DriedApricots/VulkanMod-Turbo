{
  "schemaVersion": 1,
  "id": "vulkanmodturbo",
  "version": "${version}",
  "name": "VulkanMod Turbo",
  "description": "Unofficial fork of VulkanMod (by Collateral) for Minecraft 26.2: Vulkan renderer with extra optimizations, Sodium Extra style settings and bundled performance mods. Not affiliated with the VulkanMod project. LGPL-3.0.",
  "authors": ["DriedApricots"],
  "contributors": ["Collateral (VulkanMod)"],
  "contact": {
    "homepage": "https://github.com/DriedApricots/VulkanMod-Turbo",
    "sources": "https://github.com/DriedApricots/VulkanMod-Turbo",
    "issues": "https://github.com/DriedApricots/VulkanMod-Turbo/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/vulkanmod/vlogo.png",
  "environment": "client",
  "provides": ["vulkanmod"],
  "entrypoints": {
    "client": ["net.vulkanmod.Initializer"]
  },
  "mixins": ["vulkanmod.mixins.json"],
  "accessWidener": "vulkanmod.accesswidener",
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": ">=26.2"
  },
  "breaks": {
    "sodium": "*",
    "iris": "*"
  },
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  }
}